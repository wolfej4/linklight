# LAN Party Manager: environment for Docker Compose / Dockhand
# Copy to .env (or paste into Dockhand's stack environment editor) and fill in.
# Only the Required section is needed to run. Everything else turns features on.

# ---- Required ---------------------------------------------------------------

# Organizer sign-in password. Still works after you set up accounts, so you can't lock yourself out.
ADMIN_PASSWORD=change-me

# LAN IP of the Docker host. Players type this into games to join hosted servers.
PUBLIC_HOST=192.168.1.50

# Where the database and custom server templates live on the host. Use an absolute path.
DATA_PATH=/srv/lanparty/data

# ---- Site -------------------------------------------------------------------

# Name shown in the header of the public site.
SITE_NAME=LAN Party

# Accounts with these emails (comma separated) become organizers when they sign in.
ADMIN_EMAILS=

# Web UI port (host and container).
PORT=1337

# Full public URL. Required for Discord, Google, Apple, Stripe and PayPal, because they
# send people back to this address. Apple only works over https.
BASE_URL=
# BASE_URL=https://lan.example.com

# ---- Sign-in providers ----------------------------------------------------------
# Callback URL to register with each provider: <BASE_URL>/auth/<provider>/callback

# Steam needs no keys. The API key just fills in the persona name and avatar.
# https://steamcommunity.com/dev/apikey
STEAM_LOGIN=true
STEAM_API_KEY=

# https://discord.com/developers/applications  (OAuth2 > Redirects)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# https://console.cloud.google.com/apis/credentials  (OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# https://developer.apple.com/account/resources  (needs a paid Apple Developer account)
# APPLE_CLIENT_ID is the Services ID. Give the .p8 key either inline (\n for newlines) or as a file path.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_FILE=

# ---- Email (sign-in links, receipts, gifted tickets) ------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# starttls | ssl | none
SMTP_SECURITY=starttls
# Testing only: without SMTP, print sign-in links to the container log.
EMAIL_TO_LOG=

# ---- Payments ---------------------------------------------------------------------
# A currency with cents, e.g. USD, EUR, GBP, CAD.
CURRENCY=USD

# https://dashboard.stripe.com/apikeys
# Webhook endpoint: <BASE_URL>/webhooks/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_MODE=sandbox

# ---- Optional ---------------------------------------------------------------

# Power estimate (watts) for attendees who don't give one.
DEFAULT_WATTS=450

# Session signing key. Leave blank to auto-generate one into DATA_PATH.
SECRET_KEY=

TZ=America/Chicago

# Image and container names. Change if you build under a different tag.
IMAGE=lanparty-manager:latest
CONTAINER_NAME=lanparty

# Docker socket on the host (enables the game server module).
DOCKER_SOCK=/var/run/docker.sock
