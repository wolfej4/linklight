# LAN Party Manager: environment for Docker Compose / Dockhand
# Copy to .env (or paste into Dockhand's stack environment editor) and fill in.

# ---- Required ---------------------------------------------------------------

# Organizer sign-in password. The stack refuses to start without it.
ADMIN_PASSWORD=change-me-before-deploying

# LAN IP of the Docker host. Players type this into games to join hosted servers.
# Use the box's address on your main LAN, not the ISP-side network.
PUBLIC_HOST=192.168.0.50

# Where the database and custom server templates live on the host.
# Use an absolute path: Dockhand runs stacks from its own data folder,
# so a relative path like ./data would end up inside Dockhand.
DATA_PATH=/mnt/user/appdata/lanparty

# ---- Network ----------------------------------------------------------------

# Web UI port (host and container). Open http://<PUBLIC_HOST>:<PORT>
PORT=1337

# Full public URL when behind a reverse proxy, used in QR codes and player links.
# Leave blank on a flat LAN or at a venue.
BASE_URL=
# BASE_URL=https://lan.wolfe.house

# ---- Optional ---------------------------------------------------------------

# Power estimate (watts) for attendees who don't give one.
DEFAULT_WATTS=450

# Session signing key. Leave blank to auto-generate one into DATA_PATH.
# Set it only if you want sessions to survive wiping the data folder:
#   openssl rand -hex 32
SECRET_KEY=

TZ=America/Chicago

# Image and container names. Change if you build under a different tag.
IMAGE=lanparty-manager:latest
CONTAINER_NAME=lanparty

# Docker socket on the host (enables the game server module).
DOCKER_SOCK=/var/run/docker.sock
